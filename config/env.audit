
# ===== artemis-audit-kit (ajouté par scripts/installer.sh) =====
# Valeurs contenant espaces ou parenthèses : entre guillemets, le fichier est aussi lu par bash.

# Publication de l'interface et de l'API (scripts/generer-surcharge.sh).
AUDIT_PORT_WEB=5050
AUDIT_BIND_EXTRA=
AUDIT_DNS=9.9.9.9,1.1.1.1

# Identification du trafic : nom de l'outil et contact joignable par les sites audités.
CUSTOM_USER_AGENT="audit-surface/0.1 (+mailto:securite@example.org)"

# Débit de production. Réglages : docs/exploitation.md.
REQUESTS_PER_SECOND=2
LOCK_SCANNED_TARGETS=True
DNS_QUERIES_PER_SECOND=10

# Modules décochés par défaut dans l'interface. Les modules intrusifs ne sont pas démarrés.
MODULES_DISABLED_BY_DEFAULT=admin_panel_login_bruter,api_scanner,example,leak_scanner,ssh_bruter,xss_scanner,wordpress_bruter,ftp_bruter,mysql_bruter,postgresql_bruter,sql_injection_detector,command_injection_detector,lfi_detector,orm_injection_detector

REMOVE_LOGS_AFTER_DAYS=14

# Accès. __GENERE__ est remplacé par une valeur aléatoire à l'installation.
FRONTEND_USERNAME=audit
FRONTEND_PASSWORD=__GENERE__
API_TOKEN=__GENERE__

# Enrichissement, optionnel.
# WORDFENCE_API_KEY=
# SHODAN_API_KEY=
# SUBFINDER_API_KEYS='{"github":["..."],"virustotal":["..."]}'
